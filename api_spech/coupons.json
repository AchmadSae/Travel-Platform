{
    "openapi": "3.1.0",
    "info": {
        "title": "coupons API",
        "description": "coupons API in travels applications need tokens for the requests, this API also linkage for the user as customers, API manage the coupons validations applayments and manage the remaining coupons",
        "version": "1.0.0", "contact": {
            "name" : "Achmad Saepudin",
            "email" : "sssnerv@gmail.com",
            "url" : "https://github.com/AchmadSae"
        },
        "license": {
            "name" : "Apache-2.0",
            "url" : "https://github.com/AchmadSae/travels-api/blob/main/LICENSE"
        }
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Local server"
        },
        {
            "url": "https://digi.com",
            "description": "production server"
        }
    ],
    "paths": {
        "/api/coupon/reedem/{order_id}" : {
            "post": {
                "summary": "Reedem Coupon",
                "description": "Reedem Coupon by order_id when customers payments",
                "responses": {
                    "200": {
                        "description": "Coupon reedemed successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "price_after_discount": {
                                            "type": "number"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "500": {
                        "description": "internal server error"
                    }
                },
                "security": [
                    {
                        "apiKeys": []
                    },
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "order_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ]
            }
        },
        "/api/coupons" : {
            "get": {
                "summary": "Get All Coupons",
                "description": "Get Coupons",
                "responses": {
                    "200": {
                        "description": "Coupons retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/coupons"
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "internal server error"
                    }
                },
                "security": [
                    {
                        "apiKeys": []
                    },
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/coupon/add": {
            "post": {
                "summary": "Add Coupon by Id",
                "description": "Add existing coupons",
                "responses": {
                    "200": {
                        "description": "Add coupon successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string",
                                    "properties": {
                                        "coupon_id": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "500": {
                        "description": "internal server error"
                    }
                },
                "security": [
                    {
                        "apiKeys": []
                    },
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/coupons"
                            }
                        }
                    }
                }
            }
        },
        "/api/coupon/edit/{id}": {
            "put": {
                "summary": "Edit Coupon by Id",
                "description": "Edit existing coupons",
                "responses": {
                    "200": {
                        "description": "Edit coupon successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string",
                                    "properties": {
                                        "coupon_id": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "500": {
                        "description": "internal server error"
                    }
                },
                "security": [
                    {
                        "apiKeys": []
                    },
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/coupons"
                            }
                        }
                    }
                }
            }
        },
        "/api/coupon/delete/{id}": {
            "delete": {
                "summary": "Delete existing coupons",
                "responses": {
                    "200": {
                        "description": "Delete coupon successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string",
                                    "properties": {
                                        "coupon_id": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "500": {
                        "description": "internal server error"
                    }
                },
                "security": [
                    {
                        "apiKeys": []
                    },
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "coupons":{
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "coupon_discount": {
                        "type": "number"
                    },
                    "valid_form":{
                        "type": "date"
                    },
                    "valid_to": {
                        "type": "date"
                    },
                    "descriptions": {
                        "type": "string"
                    }
                }
            }
        },
        "securitySchemes": {
            "apiKeys": {
                "type": "apiKey",
                "in": "header",
                "name": "X-CLIENT-ID",
                "description": "Define the specific client id to access the API"
            },
            "bearerAuth": {
                "type": "apiKey",
                "in": "header",
                "name": "X-CREDENTIALS-TOKEN",
                "description": "Define the specific token to access the API"
            }
        }
    }
}
